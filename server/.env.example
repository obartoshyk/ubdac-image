DATABASE_URL=postgresql://ubdac:ubdac_pass@localhost:5433/ubdac
JWT_SECRET=change_me_in_production
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────
# Получить на https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
#
# Вариант 1 — JSON-файл (local dev, файл лежит в env-secrets/, не в git):
SECRETS_JSON=../env-secrets/google.json
#
# Формат JSON:
# {
#   "GOOGLE_CLIENT_ID":     "...",
#   "GOOGLE_CLIENT_SECRET": "...",
#   "GOOGLE_CALLBACK_URL":  "http://localhost:3001/api/auth/google/callback"
# }
#
# Вариант 2 — K8s Secrets, смонтированные как файлы:
# GOOGLE_CLIENT_ID_FILE=/var/run/secrets/google_client_id
# GOOGLE_CLIENT_SECRET_FILE=/var/run/secrets/google_client_secret
#
# Вариант 3 — переменные напрямую:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
#
# То же работает для любого секрета: DATABASE_URL_FILE, JWT_SECRET_FILE и т.д.
