DATABASE_URL=postgresql://ubdac:ubdac_pass@localhost:5433/ubdac
JWT_SECRET=change_me_in_production
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Secrets files ─────────────────────────────────────────────────
# Comma-separated list of JSON files. Each file is merged into a flat map.
# Files not found are skipped with a warning (useful for optional integrations).
SECRETS_JSON=../env-secrets/google.json,../env-secrets/stripe.json

# ── Google OAuth ──────────────────────────────────────────────────
# Get credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
#
# Option 1 — JSON file (local dev, stored in env-secrets/, not in git):
# SECRETS_JSON=../env-secrets/google.json
#
# File format (Google Cloud Console download):
# { "web": { "client_id": "...", "client_secret": "...", "redirect_uris": [...] } }
#
# Option 2 — K8s Secrets mounted as files:
# GOOGLE_CLIENT_ID_FILE=/var/run/secrets/google_client_id
# GOOGLE_CLIENT_SECRET_FILE=/var/run/secrets/google_client_secret
#
# Option 3 — plain env vars:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Stripe ────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
# For webhooks: stripe listen --forward-to localhost:3001/api/payments/webhook
#
# Option 1 — JSON file (see env-secrets/stripe.json.example):
# (included via SECRETS_JSON above)
#
# Option 2 — plain env vars:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
